        {
          "name": "Register Admin - Blocked",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Register ADMIN is blocked with 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Response explains admin registration is not allowed', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(false);",
                  "  pm.expect(json.message).to.include('Admin registration is not allowed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
